{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesco-image-generator",
  "compatibility_date": "2025-11-24",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "TESCO_DB",
      "database_name": "tesco-image-generator-db",
